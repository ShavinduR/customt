# ─────────────────────────────────────────────────────────────
# CustomT Backend - Environment Configuration
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/customt?retryWrites=true&w=majority

# JWT - use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (Vite dev server default: 5173)
CLIENT_URL=http://localhost:5173

# Public base URL of this API (used to build absolute logo URLs)
PUBLIC_API_URL=http://localhost:5000

# Reverse auction tuning
# Default auction duration is 24 hours (1440 minutes). Lower it for live demos.
AUCTION_DURATION_MINUTES=1440
# How often (ms) the scheduler closes expired auctions
AUCTION_SCHEDULER_INTERVAL_MS=10000
# Reverse-auction convention: a vendor may only keep or lower their price when re-bidding.
ALLOW_BID_PRICE_INCREASE=false

# Mock payment gateway artificial latency (ms) to simulate a real gateway round trip
MOCK_GATEWAY_LATENCY_MS=800

# Logo uploads
MAX_UPLOAD_MB=2

# Seed script (npm run seed / npm run seed:admin)
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@customt.lk
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345
